{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build cuda main",
            "type": "shell",
            "command": "nvcc",
            "args": [
                "-o",
                "${workspaceFolder}/main",
                "${workspaceFolder}/main.cu",
                "-std=c++14",
                "-arch=sm_75",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/tester"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run cuda main",
            "type": "shell",
            "command": "${workspaceFolder}/main",
            "args": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "dependsOn": "build cuda main"
        }
    ]
}
